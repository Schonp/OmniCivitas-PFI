# Copiar a .env y completar. Nunca commitear .env con valores reales.

# --- App ---
ENV=development
DEBUG=true

# --- Base de datos (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnicivitas
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnicivitas_test

# --- LLM ---
ANTHROPIC_API_KEY=
AGENTE_MODELO_INTAKE=claude-haiku-4-5-20251001
AGENTE_MODELO_EJECUTOR=claude-sonnet-5
AGENTE_UMBRAL_CONFIANZA=0.6
# Minutos que el agente se queda callado sobre un caso ya derivado a una
# persona. Bajalo para las demos: con 30 no se llega a ver el acuse de recibo.
AGENTE_MINUTOS_SILENCIO_DERIVADO=30

# --- Auth ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encriptación de datos de contacto (cryptography.fernet) ---
FERNET_KEY=
HASH_LOOKUP_KEY=

# --- WhatsApp (Cloud API de Meta, sin intermediario) ---
# Se sacan de developers.facebook.com > tu app > WhatsApp.
# VERIFY_TOKEN lo inventás vos y lo repetís al dar de alta el webhook.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Twilio (solo canal de voz, fase posterior) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=

# --- Email (IMAP/SMTP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Voz (ASR/TTS propio, ver voz_asr_tts/) ---
VOZ_ASR_TTS_URL=http://localhost:8001

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100
