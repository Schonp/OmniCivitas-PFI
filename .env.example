# Copiar a .env y completar. Nunca commitear .env con valores reales.

# --- App ---
ENV=development
DEBUG=true

# --- Base de datos (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnicivitas
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnicivitas_test

# --- Cache / colas ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Auth ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encriptación de datos de contacto (cryptography.fernet) ---
FERNET_KEY=

# --- Twilio (WhatsApp / SMS / Voz) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=

# --- Email (IMAP/SMTP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Voz (Whisper ASR) ---
WHISPER_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100
